# FastAPI
SESSION_SECRET=change-me-to-a-long-random-string
APP_BASE_URL=http://localhost:8000
DEBUG=true

# Google OAuth (create at https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_EMAIL_DOMAIN=eupry.com

# DataForSEO (https://app.dataforseo.com/api-access)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Cost guardrail
MAX_COST_PER_RUN_USD=2.00

# Eupry domain to check for cannibalization
EUPRY_DOMAIN=eupry.com

# Google Sheets competitor list (service account JSON path + sheet ID)
COMPETITORS_SHEET_ID=10EtUFYPH5TyOdeQZW7P7IYYcHgoOadYxlJXfvMonxOM
GOOGLE_SERVICE_ACCOUNT_JSON=

# OpenRouter (https://openrouter.ai/keys) — for clustering + exec summary
OPENROUTER_API_KEY=
# Default: Claude Sonnet 4.6. Confirmed slug uses dots, not dashes.
# Cheaper alt: anthropic/claude-haiku-4.5 (no prompt caching benefit at our payload size).
OPENROUTER_MODEL=anthropic/claude-sonnet-4.6
# Optional: identifies your app on OpenRouter leaderboard. Not required.
OPENROUTER_APP_URL=
OPENROUTER_APP_TITLE=Eupry Keyword Portal
